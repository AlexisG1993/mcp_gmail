{
  "name": "gmail-mcp-server",
  "version": "0.2.0",
  "description": "Least-privilege MCP server for Gmail: search, read, and draft replies. Never sends.",
  "private": true,
  "license": "MIT",
  "author": "AlexisG1993",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexisG1993/mcp_gmail.git"
  },
  "homepage": "https://github.com/AlexisG1993/mcp_gmail#readme",
  "bugs": {
    "url": "https://github.com/AlexisG1993/mcp_gmail/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "email",
    "ai-agents",
    "claude",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth": "npm run build && node dist/auth.js",
    "typecheck": "tsc --noEmit && tsc -p tests && tsc -p examples",
    "test": "vitest run",
    "demo": "npm run build && tsx examples/triage-demo.ts",
    "eval": "tsx examples/eval/run-eval.ts",
    "agent": "npm run build && tsx examples/triage-agent.ts",
    "eval:agent": "tsx examples/eval/agent-eval.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "google-auth-library": "^11.3.2",
    "googleapis": "^189.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
